          "selector": "section.current [name='sex']",
          "kind": "radio",
          "required": true
        },
        {
          "key": "civil_status",
          "label": "10. Civil status",
          "selector": "section.current [name='civil_status']",
          "kind": "select",
          "required": true
        }
      ],
      "next": "section.current button[data-next]",
      "ready": "section.current[data-page=\"1\"]"
    },
    {
      "title": "Travel document",
      "fields": [
        {
          "key": "document_type",
          "label": "13. Type of travel document",
          "selector": "section.current [name='document_type']",
          "kind": "select",
          "required": true
        },
        {
          "key": "document_number",
