          "selector": "section.current [name='entries']",
          "kind": "radio",
          "required": true
        },
        {
          "key": "arrival_date",
          "label": "28. Intended date of arrival",
          "selector": "section.current [name='arrival_date']",
          "kind": "text",
          "required": true
        },
        {
          "key": "departure_date",
          "label": "29. Intended date of departure",
          "selector": "section.current [name='departure_date']",
          "kind": "text",
          "required": true
        },
        {
          "key": "fingerprints",
          "label": "30. Fingerprints collected previously",
          "selector": "section.current [name='fingerprints']",
          "kind": "radio",
          "required": true
        },
        {
          "key": "fingerprints_date",
          "label": "30. Date fingerprints were taken",
          "selector": "section.current [name='fingerprints_date']",
          "kind": "text",
          "required": false
        },
        {
          "key": "accommodation",
          "label": "31. Accommodation or inviting person",
          "selector": "section.current [name='accommodation']",
          "kind": "text",
          "required": true
        },
        {
          "key": "cost_covered_by",
          "label": "33. Cost of the stay covered by",
          "selector": "section.current [name='cost_covered_by']",
          "kind": "radio",
          "required": true
        },
        {
          "key": "sponsor",
          "label": "33. Sponsor",
          "selector": "section.current [name='sponsor']",
          "kind": "text",
          "required": false
        }
      ],
      "next": "section.current button[data-next]",
      "ready": "section.current[data-page=\"4\"]"
    },
    {
      "title": "Declaration and submission",
      "fields": [],
      "next": null,
      "ready": "section.current[data-page=\"5\"]"
    }
