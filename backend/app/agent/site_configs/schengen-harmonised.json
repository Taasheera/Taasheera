          "selector": "section.current [name='document_number']",
          "kind": "text",
          "required": true
        },
        {
          "key": "issue_date",
          "label": "15. Date of issue",
          "selector": "section.current [name='issue_date']",
          "kind": "text",
          "required": true
        },
        {
          "key": "valid_until",
          "label": "16. Valid until",
          "selector": "section.current [name='valid_until']",
          "kind": "text",
          "required": true
