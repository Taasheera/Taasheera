          "selector": "section.current [name='surname']",
          "kind": "text",
          "required": true
        },
        {
          "key": "surname_at_birth",
          "label": "2. Surname at birth",
          "selector": "section.current [name='surname_at_birth']",
          "kind": "text",
          "required": false
        },
        {
          "key": "first_names",
          "label": "3. First name(s)",
          "selector": "section.current [name='first_names']",
          "kind": "text",
          "required": true
        },
        {
          "key": "date_of_birth",
          "label": "4. Date of birth",
          "selector": "section.current [name='date_of_birth']",
          "kind": "text",
          "required": true
        },
        {
          "key": "place_of_birth",
          "label": "5. Place of birth",
          "selector": "section.current [name='place_of_birth']",
          "kind": "text",
          "required": true
        },
        {
          "key": "country_of_birth",
          "label": "6. Country of birth",
          "selector": "section.current [name='country_of_birth']",
          "kind": "select",
          "required": true
        },
        {
          "key": "nationality",
