        {
          "key": "issued_by",
          "label": "17. Issued by",
          "selector": "section.current [name='issued_by']",
          "kind": "select",
          "required": true
        }
      ],
      "next": "section.current button[data-next]",
      "ready": "section.current[data-page=\"2\"]"
    },
    {
      "title": "Contact details and occupation",
      "fields": [
        {
          "key": "home_address",
          "label": "19. Home address",
          "selector": "section.current [name='home_address']",
          "kind": "text",
          "required": true
        },
        {
          "key": "email",
          "label": "19. Email address",
          "selector": "section.current [name='email']",
          "kind": "text",
          "required": true
        },
        {
          "key": "phone",
          "label": "19. Telephone number",
          "selector": "section.current [name='phone']",
          "kind": "text",
          "required": true
        },
        {
          "key": "occupation",
          "label": "21. Current occupation",
          "selector": "section.current [name='occupation']",
          "kind": "text",
          "required": true
        },
        {
          "key": "employer",
          "label": "22. Employer or school",
          "selector": "section.current [name='employer']",
          "kind": "text",
          "required": false
        }
      ],
      "next": "section.current button[data-next]",
      "ready": "section.current[data-page=\"3\"]"
    },
    {
      "title": "Your journey",
      "fields": [
        {
          "key": "purpose",
          "label": "23. Purpose of the journey",
          "selector": "section.current [name='purpose']",
          "kind": "select",
          "required": true
        },
        {
          "key": "main_destination",
