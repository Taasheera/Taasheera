{
  "id": "india-tourist",
  "version": 1,
  "destination": "IND",
  "visa_type": "tourist",
  "title": "India tourist visa",
  "destination_label": "India",
  "destination_description": "All states and union territories, for a holiday or a visit",
  "visa_label": "Tourist visa",
  "visa_description": "For sightseeing, visiting friends or relatives, or a short yoga programme. Some passports can use the e-Tourist Visa instead.",
  "summary": {
    "place": null,
    "date": "arrival_date"
  },
  "source": "Indian Visa Online application form (regular and e-Tourist Visa), Government of India",
  "steps": [
    {
      "id": "eligibility",
      "title": "Eligibility",
      "questions": [
        {
          "id": "purpose",
          "type": "choice",
          "prompt": "What's the main purpose of your trip to India?",
          "options": [
            {
              "value": "tourism",
              "label": "Sightseeing or a holiday"
            },
            {
              "value": "family_friends",
              "label": "Visiting friends or relatives"
            },
            {
              "value": "yoga",
              "label": "A short yoga programme"
            }
          ]
        },
        {
          "id": "work_or_study",
          "type": "yes_no",
          "prompt": "Will you work, study or do business in India?",
          "stop_if": {
            "in": [
              true
            ],
            "message": "Work, study and business trips need a different Indian visa, which Ta'asheera can't prepare yet."
          }
        }
      ]
    },
    {
      "id": "passport",
      "title": "Passport",
      "questions": [
        {
          "id": "passport",
          "type": "passport",
          "prefill": "passport",
          "prompt": "Let's add your passport. You can upload a photo of its details page and confirm what we read, or type the details yourself."
        },
        {
          "id": "passport_issue_date",
          "type": "date",
          "prompt": "When was your passport issued?",
          "help": "It's printed on the details page, usually next to the expiry date.",
          "rules": [
            {
              "op": "<=",
              "ref": "today",
              "message": "The issue date can't be in the future."
            }
          ]
        },
        {
          "id": "passport_issue_place",
          "type": "text",
          "prompt": "Where was your passport issued?",
          "max_length": 120,
          "help": "The city or authority printed on the details page, for example Beirut."
        }
      ]
    },
    {
      "id": "personal",
      "title": "About you",
      "questions": [
        {
          "id": "place_of_birth",
          "type": "text",
          "prompt": "Which city or town were you born in?",
          "max_length": 120
        },
        {
          "id": "country_of_birth",
          "type": "country",
          "prompt": "And which country is that in?"
        },
        {
          "id": "marital_status",
          "type": "choice",
          "prompt": "What's your marital status?",
          "options": [
            {
              "value": "single",
              "label": "Single"
            },
            {
              "value": "married",
              "label": "Married"
            },
            {
              "value": "divorced",
              "label": "Divorced"
            },
            {
              "value": "separated",
              "label": "Separated"
            },
            {
              "value": "widowed",
              "label": "Widowed"
            }
          ]
        },
        {
          "id": "father_name",
          "type": "text",
          "prompt": "What's your father's full name?",
          "max_length": 120
        },
        {
          "id": "mother_name",
          "type": "text",
          "prompt": "What's your mother's full name?",
          "max_length": 120
        },
        {
          "id": "home_address",
          "type": "address",
          "prompt": "What's your home address?"
        },
        {
          "id": "phone",
          "type": "phone",
          "prompt": "What phone number can the embassy reach you on?",
          "help": "Include the country code, for example +961 71 123 456."
        },
        {
          "id": "occupation",
          "type": "choice",
          "prompt": "What do you currently do?",
          "options": [
            {
              "value": "employed",
              "label": "I'm employed"
            },
            {
              "value": "self_employed",
              "label": "I'm self-employed"
            },
            {
              "value": "student",
              "label": "I'm a student"
            },
            {
              "value": "retired",
              "label": "I'm retired"
            },
            {
              "value": "homemaker",
              "label": "I look after my home and family"
            },
            {
              "value": "unemployed",
              "label": "I'm not working"
            }
          ]
        },
        {
          "id": "job_title",
          "type": "text",
          "prompt": "What's your job title?",
          "max_length": 120,
          "help": "As your employer would write it, for example Accountant or Software engineer.",
          "show_if": {
            "question": "occupation",
            "in": [
              "employed",
              "self_employed"
            ]
          }
        },
        {
          "id": "employer",
          "type": "text",
          "prompt": "What's the name and address of your employer or business?",
          "max_length": 300,
          "show_if": {
            "question": "occupation",
            "in": [
              "employed",
              "self_employed"
            ]
          }
        },
        {
          "id": "school",
          "type": "text",
          "prompt": "Which school or university do you attend?",
          "max_length": 200,
          "show_if": {
            "question": "occupation",
            "in": [
              "student"
            ]
          }
        },
        {
          "id": "education",
          "type": "choice",
          "prompt": "What's your highest level of education?",
          "options": [
            {
              "value": "secondary",
              "label": "Secondary school"
            },
            {
              "value": "diploma",
              "label": "Diploma or vocational"
            },
            {
              "value": "graduate",
              "label": "University degree"
            },
            {
              "value": "postgraduate",
              "label": "Postgraduate degree"
            },
            {
              "value": "none",
              "label": "None of these"
            }
          ]
        }
      ]
    },
    {
      "id": "trip",
      "title": "Your trip",
      "questions": [
        {
          "id": "arrival_date",
          "type": "date",
          "prompt": "When do you plan to arrive in India?",
          "rules": [
            {
              "op": ">=",
              "ref": "today",
              "days": 1,
              "message": "Your arrival date needs to be in the future."
            }
          ]
        },
        {
          "id": "departure_date",
          "type": "date",
          "prompt": "And when will you leave?",
          "rules": [
            {
              "op": ">=",
              "ref": "arrival_date",
              "message": "You can't leave before you arrive."
            },
            {
              "op": "<=",
              "ref": "arrival_date",
              "days": 180,
              "message": "A tourist visit is up to 180 days."
            },
            {
              "op": "<=",
              "ref": "passport.expiry_date",
              "message": "Your passport must be valid for your whole stay: a visa can't outlast it."
            }
          ]
        },
        {
          "id": "port_of_arrival",
          "type": "text",
          "prompt": "Which airport will you arrive at?",
          "max_length": 80,
          "help": "For example Delhi, Mumbai or Bengaluru."
        },
        {
          "id": "places_to_visit",
          "type": "text",
          "prompt": "Which places will you visit?",
          "max_length": 300
        },
        {
          "id": "accommodation",
          "type": "choice",
          "prompt": "Where will you stay in India?",
          "options": [
            {
              "value": "hotel",
              "label": "A hotel"
            },
            {
              "value": "rental",
              "label": "A rented flat or house"
            },
            {
              "value": "host",
              "label": "With family or friends"
            },
            {
              "value": "other",
              "label": "Somewhere else"
            }
          ]
        },
        {
          "id": "accommodation_details",
          "type": "text",
          "prompt": "What's the name, address and phone number of the place you're staying?",
          "max_length": 300,
          "show_if": {
            "question": "accommodation",
            "in": [
              "hotel",
              "rental",
              "other"
            ]
          }
        },
        {
          "id": "host_details",
          "type": "text",
          "prompt": "Who's hosting you? Give their full name, address, phone number and how you know them.",
          "max_length": 300,
          "show_if": {
            "question": "accommodation",
            "in": [
              "host"
            ]
          }
        },
        {
          "id": "funding",
          "type": "choice",
          "prompt": "Who's paying for the trip?",
          "options": [
            {
              "value": "self",
              "label": "I am"
            },
            {
              "value": "sponsor",
              "label": "Someone else (a sponsor)"
            }
          ]
        },
        {
          "id": "sponsor_details",
          "type": "text",
          "prompt": "Who's your sponsor, and how are they related to you?",
          "max_length": 300,
          "show_if": {
            "question": "funding",
            "in": [
              "sponsor"
            ]
          }
        },
        {
          "id": "reference_in_india",
          "type": "text",
          "prompt": "Who can India's authorities contact in India? Give a name, address and phone number (your hotel is fine).",
          "max_length": 300
        },
        {
          "id": "reference_at_home",
          "type": "text",
          "prompt": "And a reference in your home country: name, address and phone number.",
          "max_length": 300
        },
        {
          "id": "previous_india_visit",
          "type": "yes_no",
          "prompt": "Have you been to India before?"
        },
        {
          "id": "previous_refusal",
          "type": "yes_no",
          "prompt": "Have you ever been refused an Indian visa?"
        },
        {
          "id": "countries_visited",
          "type": "text",
          "prompt": "Which countries have you visited in the last 10 years?",
          "max_length": 400,
          "help": "List them separated by commas, or write None."
        }
      ]
    }
  ],
  "documents": [
    {
      "id": "photo",
      "label": "Visa photo",
      "help": "Square, white background, at least 350 x 350 pixels for the online form (2 x 2 inches printed).",
      "crosscheck": false
    },
    {
      "id": "flight_booking",
      "label": "Return ticket",
      "help": "A return or onward booking."
    },
    {
      "id": "accommodation_proof",
      "label": "Hotel booking or address in India",
      "help": "Where you'll stay.",
      "show_if": {
        "question": "accommodation",
        "in": [
          "hotel",
          "rental",
          "other"
        ]
      }
    },
    {
      "id": "invitation_letter",
      "label": "Letter from your host",
      "help": "Your host's address and a copy of their ID.",
      "show_if": {
        "question": "accommodation",
        "in": [
          "host"
        ]
      }
    },
    {
      "id": "bank_statements",
      "label": "Bank statements",
      "help": "Your last 3 to 6 months of statements, showing you can pay for the trip.",
      "required": false
    }
  ]
}
